{
  "manifest_version": 2,
  "name": "YouTube Trust Hint (Local)",
  "version": "0.1",
  "description": "Local-only trust hints for YouTube based only on visible page content.",
  "permissions": ["storage", "activeTab", "tabs", "https://www.youtube.com/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "YT Trust Hint"
  }
}
